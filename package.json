{
  "name": "aiready-kit",
  "version": "0.2.0",
  "description": "My personal Claude Code skills and rules, with a terminal wizard to install them.",
  "type": "module",
  "bin": {
    "aiready-kit": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "rules",
    "templates"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "docs": "node scripts/gen-docs.js",
    "check": "node scripts/gen-docs.js --check"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "lucasviga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasviga/aiready-kit.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "rules",
    "cli",
    "wizard"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  }
}
